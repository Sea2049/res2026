{
  "name": "browser-worker",
  "version": "0.1.0",
  "private": true,
  "main": "src/server.ts",
  "scripts": {
    "dev": "ts-node src/server.ts",
    "build": "tsc",
    "test": "jest",
    "test:capacity": "jest --config tests/capacity/jest.config.capacity.js --runInBand",
    "test:capacity:scenario-a": "jest --config tests/capacity/jest.config.capacity.js scenario-a --runInBand",
    "test:capacity:scenario-b": "jest --config tests/capacity/jest.config.capacity.js scenario-b --runInBand",
    "test:capacity:scenario-c": "jest --config tests/capacity/jest.config.capacity.js scenario-c --runInBand"
  },
  "dependencies": {
    "better-sqlite3": "^9.0.0",
    "pg": "^8.11.0",
    "playwright": "^1.40.0",
    "express": "^4.18.0",
    "cross-env": "^7.0.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/pg": "^8.11.0",
    "@types/express": "^4.17.0",
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0",
    "ts-node": "^10.9.0",
    "jest": "^29.0.0",
    "@types/jest": "^29.0.0",
    "ts-jest": "^29.0.0"
  }
}
