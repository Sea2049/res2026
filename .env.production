# 生产环境变量
# 请根据实际配置修改以下值

# 应用配置
NODE_ENV=production
PORT=3001

# Reddit API 配置（如需要认证）
# REDDIT_CLIENT_ID=your_client_id
# REDDIT_CLIENT_SECRET=your_client_secret

# 可选：自定义域名
# NEXT_PUBLIC_APP_URL=https://your-domain.com

# 邀请码功能配置
DATABASE_URL="file:/app/data/prod.db"
ADMIN_PASSWORD="请修改为强密码"
INVITE_COOKIE_MAX_AGE=604800

# 邀请码 Token 签名密钥（重要：请修改为随机字符串）
INVITE_TOKEN_SECRET="请修改为至少32字符的随机密钥"

# CORS 代理配置（可选，生产环境建议配置自己的代理服务）
# NEXT_PUBLIC_CORS_PROXY_URL=https://api.codetabs.com/v1/proxy?quest=
# CORS_PROXY_ALLORIGINS=https://api.allorigins.win/raw
# CORS_PROXY_IO=https://api.corsproxy.io
# CORS_PROXY_CODETABS=https://api.codetabs.com/v1/proxy
