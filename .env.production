# 生产环境变量
# 请根据实际配置修改以下值

# 应用配置
NODE_ENV=production
PORT=3001

# Reddit API 配置（如需要认证）
# REDDIT_CLIENT_ID=your_client_id
# REDDIT_CLIENT_SECRET=your_client_secret

# 可选：自定义域名
# NEXT_PUBLIC_APP_URL=https://your-domain.com

# Reddit API 代理（推荐：部署 Cloudflare Worker，见 scripts/cf-reddit-proxy-worker.js）
# REDDIT_PROXY_URL=https://your-worker.your-account.workers.dev

# 本地代理（如 Clash，可选）
# HTTP_PROXY=http://127.0.0.1:7890

# CORS 代理配置（备用，公共代理不稳定）
# CORS_PROXY_ALLORIGINS=https://api.allorigins.win/raw
# CORS_PROXY_IO=https://api.corsproxy.io
# CORS_PROXY_CODETABS=https://api.codetabs.com/v1/proxy
