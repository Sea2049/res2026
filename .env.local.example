# 智谱AI API配置
ZHIPU_API_KEY=your_zhipu_api_key_here
ZHIPU_API_URL=https://open.bigmodel.cn/api/paas/v4/chat/completions

# 通义千问 API 配置
QWEN_API_KEY=your_qwen_api_key_here

# 邀请码安全配置
# Token 签名密钥（建议至少32字符的随机字符串）
INVITE_TOKEN_SECRET=your-random-secret-key-at-least-32-chars
# Cookie 有效期（秒），默认 7 天
INVITE_COOKIE_MAX_AGE=604800

# CORS 代理配置（可选，使用默认值即可）
# NEXT_PUBLIC_CORS_PROXY_URL=https://api.codetabs.com/v1/proxy?quest=
# CORS_PROXY_ALLORIGINS=https://api.allorigins.win/raw
# CORS_PROXY_IO=https://api.corsproxy.io
# CORS_PROXY_CODETABS=https://api.codetabs.com/v1/proxy

# 本地开发代理（Clash 等）
# HTTP_PROXY=http://127.0.0.1:7890